# Base de données — projet Supabase en région européenne
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Accusés de réception (Resend). Sans ces deux variables, l'envoi est ignoré
# et les formulaires fonctionnent quand même.
RESEND_API_KEY=
EMAIL_FROM="Sortir du squat <bonjour@sortirdusquat.be>"

# URL publique, utilisée pour construire le lien de désinscription des emails
NEXT_PUBLIC_SITE_URL=https://sortirdusquat.be

# Administration : mot de passe unique, pas de système de comptes
ADMIN_PASSWORD=
# Secret indépendant pour signer le cookie d'administration (facultatif :
# à défaut, ADMIN_PASSWORD est utilisé)
ADMIN_COOKIE_SECRET=

# Purge automatique : Vercel présente ce secret sur la route cron
CRON_SECRET=

# Pied de page et politique de confidentialité
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=fhzegert@gmail.com
